#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/tots-openwrt
CONFIG_FILE=/etc/tots/config.uri
STATUS_FILE=/var/run/tots/status.json

start_service() {
    [ -x "$PROG" ] || return 1
    [ -s "$CONFIG_FILE" ] || {
        logger -t tots-openwrt "not starting: $CONFIG_FILE is missing or empty"
        return 0
    }

    . /lib/functions.sh
    config_load tots
    config_get workers main workers 8
    config_get_bool relay_only main relay_only 1
    # Physical WAN device that must carry ToTS transport and provider signalling.
    # Empty means "detect from the IPv4 default route".
    config_get egress_interface main egress_interface ''
    case "$workers" in
        ''|*[!0-9]*) workers=8 ;;
    esac
    [ "$workers" -ge 1 ] 2>/dev/null && [ "$workers" -le 256 ] 2>/dev/null || workers=8

    mkdir -p /var/run/tots
    chmod 700 /var/run/tots

    procd_open_instance
    procd_set_param command "$PROG" \
        --config-file "$CONFIG_FILE" \
        --tun-name tots0 \
        --status-file "$STATUS_FILE" \
        --n "$workers"
    [ "$relay_only" -eq 1 ] && procd_append_param command --relay-only
    [ -n "$egress_interface" ] && procd_append_param command --egress-interface "$egress_interface"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "tots"
}
